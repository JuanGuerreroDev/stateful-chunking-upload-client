{
  "name": "@juanoecr/stateful-chunking-upload-client",
  "version": "0.1.0",
  "description": "SDK cliente agnóstico (TS) para subida por chunks con verificación de integridad y reanudación.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit",
    "check:publish": "publint --strict",
    "check:exports": "attw --pack . --profile node16"
  },
  "size-limit": [
    {
      "name": "núcleo — entry browser (ESM, min+gzip)",
      "path": "dist/index.js",
      "limit": "10 KB"
    }
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@size-limit/preset-small-lib": "14.0.0",
    "@types/node": "^22.20.3",
    "@vitest/coverage-v8": "^3.2.4",
    "publint": "0.3.24",
    "size-limit": "14.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
