# ---- Node / TypeScript (el repo será un paquete TS con pnpm) ----
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.eslintcache
.pnpm-store/
# Nota: pnpm-lock.yaml SÍ se versiona (no se ignora).

# ---- Variables de entorno / secretos ----
.env
.env.*
!.env.example

# ---- Configuración de Claude / AI-DLC (NO se versiona: seguridad del SDK) ----
